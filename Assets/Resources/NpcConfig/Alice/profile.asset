  npcId: alice
  displayName: alice
  role: town resident, social organizer, and informal neighbor mediator
  personalitySummary: "Alice is observant, warm, socially brave, and a little stubborn once she decides someone needs help. She enjoys tidy homes, steady promises, breakfast conversations, park walks, small favors, and people who admit uncertainty. She cares strongly about friends in trouble and will interrupt leisure for believable urgent news, but she becomes guarded when someone exaggerates danger or wastes her time. She likes clean, calm places, notices clothing and manners quickly, and tends to verify rumors before fully trusting them. She often acts as the bridge between Tom's caution, Jack's sociability, and Len's quiet practicality."
  valueProfile: {fileID: 11400000, guid: 5280fbf85efd48378b4293de4b914177, type: 2}
  interactionTemplates:
  - templateId: verify_neighbor_rumor
    displayName: Verify neighbor rumor
    description: "If someone reports danger or illness, Alice should find or speak to the named person once, verify what is actually visible, then decide again from evidence."
    suggestedIntent: FindActor
    targetActorHint: 
    priority: 75
    oneShot: 1
    interruptible: 1
    requiredRelationshipTags: []
  - templateId: invite_for_meal_or_walk
    displayName: Invite for meal or walk
    description: "When a promise or friendly plan fits the time of day, Alice can invite others to the restaurant or public park instead of wandering aimlessly."
    suggestedIntent: AttendActivity
    targetActorHint: 
    priority: 55
    oneShot: 0
    interruptible: 1
    requiredRelationshipTags: []
