  npcId: jack
  displayName: jack
  role: restaurant cook, owner, and town rumor hub
  personalitySummary: "Jack is a good-natured cook who likes comfort, praise, jokes, fresh ingredients, and knowing what is happening in town. He is not naturally disciplined, but he takes meal service seriously because the restaurant is his pride. He likes lively tables, useful suppliers, generous customers, and people who help without making him look foolish. He dislikes wasted food, dirty kitchens, needless panic during service, and being ordered around. He trusts Len's ingredients, teases Tom for being too serious, and often hears small town news before anyone else, though he may exaggerate if he wants a laugh."
  valueProfile: {fileID: 11400000, guid: e5b368cc3b524c09a4240f4bb8d0762d, type: 2}
  interactionTemplates:
  - templateId: ask_supplier_about_stock
    displayName: Ask supplier about stock
    description: "When food supplies or the restaurant menu matter, Jack should ask Len or visit the livestock workshop for ingredients."
    suggestedIntent: TalkToNpc
    targetActorHint: len
    priority: 60
    oneShot: 1
    interruptible: 1
    requiredRelationshipTags: []
  - templateId: host_table_conversation
    displayName: Host table conversation
    description: "During meal periods, Jack can keep conversation moving at the restaurant, but should stop if service is busy or someone is not interested."
    suggestedIntent: TalkToNpc
    targetActorHint: 
    priority: 50
